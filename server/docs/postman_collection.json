{
  "info": {
    "name": "Campaign API — Manual Test Suite",
    "description": "Manual API tests for the campaign backend. Import into Postman, set the `baseUrl` collection variable (local: http://localhost:3100, or your Render URL), then run the folders in order 00 → 06. Collection variables (token, campaignId, ...) are filled automatically by the test scripts.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3100", "type": "string" },
    { "key": "token", "value": "", "type": "string" },
    { "key": "tokenB", "value": "", "type": "string" },
    { "key": "userId", "value": "", "type": "string" },
    { "key": "lastEmail", "value": "", "type": "string" },
    { "key": "categoryId", "value": "", "type": "string" },
    { "key": "campaignId", "value": "", "type": "string" },
    { "key": "ownershipCampaignId", "value": "", "type": "string" }
  ],
  "item": [
    {
      "name": "00 · Health",
      "item": [
        {
          "name": "Health",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', function () { pm.response.to.have.status(200); });",
                  "pm.test('status is ok', function () { pm.expect(pm.response.json().status).to.eql('ok'); });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/health", "host": ["{{baseUrl}}"], "path": ["health"] }
          }
        },
        {
          "name": "Health (database)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK and database up', function () {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(pm.response.json().database).to.eql('up');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/health/db", "host": ["{{baseUrl}}"], "path": ["health", "db"] }
          }
        }
      ]
    },
    {
      "name": "01 · Auth",
      "item": [
        {
          "name": "Register (creates user + token)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 Created', function () { pm.response.to.have.status(201); });",
                  "var body = pm.response.json();",
                  "pm.test('user has id but no passwordHash', function () {",
                  "  pm.expect(body.user).to.have.property('id');",
                  "  pm.expect(body.user).to.not.have.property('passwordHash');",
                  "});",
                  "pm.test('token returned', function () { pm.expect(body.token).to.be.a('string'); });",
                  "pm.collectionVariables.set('token', body.token);",
                  "pm.collectionVariables.set('userId', body.user.id);",
                  "pm.collectionVariables.set('lastEmail', body.user.email);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Manual Tester\",\n  \"email\": \"tester.{{$timestamp}}@example.com\",\n  \"password\": \"Passw0rd!\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{baseUrl}}/api/auth/register", "host": ["{{baseUrl}}"], "path": ["api", "auth", "register"] }
          }
        },
        {
          "name": "Register duplicate email (409)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('409 Conflict', function () { pm.response.to.have.status(409); });",
                  "pm.test('error code CONFLICT', function () { pm.expect(pm.response.json().error.code).to.eql('CONFLICT'); });"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Manual Tester\",\n  \"email\": \"{{lastEmail}}\",\n  \"password\": \"Passw0rd!\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{baseUrl}}/api/auth/register", "host": ["{{baseUrl}}"], "path": ["api", "auth", "register"] }
          }
        },
