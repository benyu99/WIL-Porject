    {
      "name": "03 · Campaign happy path",
      "item": [
        {
          "name": "Create campaign",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 Created', function () { pm.response.to.have.status(201); });",
                  "var campaign = pm.response.json().campaign;",
                  "pm.collectionVariables.set('campaignId', campaign.id);",
                  "pm.test('owner is the authenticated user', function () {",
                  "  pm.expect(campaign.ownerId).to.eql(pm.collectionVariables.get('userId'));",
                  "});",
                  "pm.test('goalAmount and status', function () {",
                  "  pm.expect(campaign.goalAmount).to.eql(5000);",
                  "  pm.expect(campaign.status).to.eql('active');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Manual test campaign {{$timestamp}}\",\n  \"description\": \"Created by the manual test collection\",\n  \"goalAmount\": 5000,\n  \"categoryId\": {{categoryId}},\n  \"status\": \"active\",\n  \"startDate\": \"2026-11-01\",\n  \"endDate\": \"2027-03-31\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{baseUrl}}/api/campaigns", "host": ["{{baseUrl}}"], "path": ["api", "campaigns"] }
          }
        },
        {
          "name": "List campaigns",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', function () { pm.response.to.have.status(200); });",
                  "var body = pm.response.json();",
                  "pm.test('list contains the created campaign', function () {",
                  "  var id = pm.collectionVariables.get('campaignId');",
                  "  pm.expect(body.items.some(function (item) { return item.id === id; })).to.be.true;",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/campaigns?page=1&limit=10",
              "host": ["{{baseUrl}}"],
              "path": ["api", "campaigns"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "10" }
              ]
            }
          }
        },
        {
          "name": "Get campaign by id",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', function () { pm.response.to.have.status(200); });",
                  "pm.test('returns the campaign', function () {",
                  "  pm.expect(pm.response.json().campaign.id).to.eql(pm.collectionVariables.get('campaignId'));",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/campaigns/{{campaignId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "campaigns", "{{campaignId}}"]
            }
          }
        },
        {
          "name": "Update campaign (owner)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', function () { pm.response.to.have.status(200); });",
                  "var campaign = pm.response.json().campaign;",
                  "pm.test('status and goal updated', function () {",
                  "  pm.expect(campaign.status).to.eql('completed');",
                  "  pm.expect(campaign.goalAmount).to.eql(6000);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"completed\",\n  \"goalAmount\": 6000\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/api/campaigns/{{campaignId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "campaigns", "{{campaignId}}"]
            }
          }
        },
        {
          "name": "Delete campaign (owner)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test('204 No Content', function () { pm.response.to.have.status(204); });"]
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/campaigns/{{campaignId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "campaigns", "{{campaignId}}"]
            }
          }
        },
        {
          "name": "Get deleted campaign (404)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('404 Not Found', function () { pm.response.to.have.status(404); });",
                  "pm.test('error code NOT_FOUND', function () { pm.expect(pm.response.json().error.code).to.eql('NOT_FOUND'); });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/campaigns/{{campaignId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "campaigns", "{{campaignId}}"]
            }
          }
        }
      ]
