# Copy this file to `.env` and fill in real values. Never commit `.env`.

# PostgreSQL connection string.
# Local PostgreSQL example:
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/campaign_dev"
# Render External Database URL (for connecting from your machine) ends with ?sslmode=require
# Render Internal Database URL (for the Web Service running on Render) does NOT need sslmode.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require"

# Secret used to sign JWTs. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Must be at least 32 characters in production.
JWT_SECRET="change-me-to-a-long-random-string-at-least-32-chars"

# Token lifetime. Examples: 7d, 12h, 60m
JWT_EXPIRES_IN="7d"

# Comma-separated list of allowed browser origins.
# Include the Vercel production domain and your local Vite dev server.
CORS_ORIGIN="http://localhost:5173,https://your-app.vercel.app"

# Port used when running locally. Render injects PORT automatically.
PORT=3100

# development | production
NODE_ENV=development
